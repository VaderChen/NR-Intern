{
  "service_name": "永不休息的實習生",
  "ui_language": "auto",
  "notifications_enabled": false,
  "listen_address": "127.0.0.1:8787",
  "data_dir": "data/ai-agent",
  "api_token": "",
  "allowed_origins": [
    "http://127.0.0.1:8790",
    "http://localhost:8790"
  ],
  "allowed_tools": [
    "plan_get",
    "plan_create",
    "plan_step_update",
    "directory_list",
    "directory_create",
    "file_read",
    "file_search",
    "file_compare",
    "file_write",
    "file_edit",
    "document_inspect",
    "document_read",
    "document_compare",
    "document_validate",
    "document_fonts",
    "document_create",
    "document_edit",
    "document_convert",
    "pdf_pages",
    "document_render",
    "http_fetch",
    "shell_exec",
    "wait_for",
    "ssh_exec",
    "ssh_wait",
    "memory_search",
    "memory_remember",
    "memory_forget"
  ],
  "allow_elevated_tools": true,
  "tool_call_mode": "native",
  "permissions": {
    "default_profile": "default",
    "elevated_profiles": [
      "default",
      "trusted"
    ],
    "allow_client_choice": false
  },
  "max_turns": 96,
  "max_autonomous_tool_turns": 0,
  "max_completion_checks": 1,
  "max_wall_clock_seconds": 7200,
  "max_tokens": 0,
  "max_tool_calls": 0,
  "max_tool_output_bytes": 524288,
  "max_file_input_bytes": 8388608,
  "context": {
    "max_estimated_tokens": 262144,
    "reserved_output_tokens": 4096,
    "retain_messages": 16,
    "max_tool_result_characters": 24000,
    "max_history_characters": 60000,
    "max_summary_input_characters": 120000,
    "max_summary_characters": 16000
  },
  "memory": {
    "enabled": true,
    "auto_recall": true,
    "recall_limit": 8,
    "max_injected_characters": 8000,
    "allow_writes": true,
    "space": {
      "recall_limit": 6,
      "max_injected_characters": 1200,
      "min_relevance": 0.15,
      "scope_cap": 500,
      "stale_days": 90
    }
  },
  "default_provider_id": "openai-compatible",
  "model_prices": {
    "openai-compatible": {
      "gpt-4o-mini": {
        "input_per_million": 0.15,
        "output_per_million": 0.6,
        "currency": "USD"
      }
    }
  },
  "providers": {
    "openai-compatible": {
      "type": "openai-compatible",
      "enabled": true,
      "openai_compatible": {
        "base_url": "https://api.openai.com/v1",
        "api_key": "",
        "model": "gpt-4o-mini",
        "context_window": 128000,
        "max_output_tokens": 16384,
        "model_limits": {
          "gpt-4o": {
            "context_window": 128000,
            "max_output_tokens": 16384
          }
        },
        "instruction_role": "system",
        "disable_streaming": false,
        "stream_include_usage": true,
        "omit_tool_choice": false,
        "max_attempts": 3,
        "timeout_seconds": 1800,
        "connect_timeout_seconds": 20,
        "response_header_timeout_seconds": 120
      }
    },
    "local": {
      "type": "openai-compatible",
      "enabled": true,
      "openai_compatible": {
        "base_url": "http://127.0.0.1:11434/v1",
        "model": "your-local-model",
        "instruction_role": "system",
        "stream_include_usage": true,
        "max_attempts": 3
      }
    }
  },
  "ssh_profiles": {},
  "http_fetch": {
    "enabled": true,
    "allow_private_networks": true,
    "max_response_bytes": 1048576,
    "timeout_seconds": 30,
    "max_redirects": 5,
    "allowed_hosts": [],
    "blocked_hosts": []
  },
  "extended_tools": false,
  "tool_retrieval": true,
  "memory_space": false
}
