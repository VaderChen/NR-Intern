{
  "service_name": "聰明的實習生",
  "listen_address": "127.0.0.1:8787",
  "data_dir": "data/ai-agent",
  "api_token": "",
  "allowed_origins": [
    "http://127.0.0.1:8790",
    "http://localhost:8790"
  ],
  "allowed_tools": [
    "plan_get",
    "plan_create",
    "plan_step_update",
    "directory_list",
    "directory_create",
    "file_read",
    "file_search",
    "file_compare",
    "file_write",
    "file_edit",
    "document_inspect",
    "document_read",
    "shell_exec",
    "ssh_exec",
    "memory_search",
    "memory_remember",
    "memory_forget"
  ],
  "allow_elevated_tools": true,
  "tool_call_mode": "instruction",
  "permissions": {
    "default_profile": "default",
    "elevated_profiles": [
      "default",
      "trusted"
    ],
    "allow_client_choice": false
  },
  "max_turns": 96,
  "max_autonomous_tool_turns": 16,
  "max_completion_checks": 1,
  "max_wall_clock_seconds": 7200,
  "max_tokens": 10000000,
  "max_tool_calls": 512,
  "max_tool_output_bytes": 524288,
  "max_file_input_bytes": 8388608,
  "context": {
    "max_estimated_tokens": 524288,
    "reserved_output_tokens": 4096,
    "retain_messages": 16,
    "max_tool_result_characters": 24000,
    "max_summary_input_characters": 120000,
    "max_summary_characters": 16000
  },
  "memory": {
    "enabled": true,
    "auto_recall": true,
    "recall_limit": 8,
    "max_injected_characters": 8000,
    "allow_writes": true
  },
  "default_provider_id": "openai-compatible",
  "providers": {
    "openai-compatible": {
      "type": "openai-compatible",
      "openai_compatible": {
        "base_url": "https://api.openai.com/v1",
        "api_key": "",
        "model": "gpt-4o-mini",
        "context_window": 128000,
        "max_output_tokens": 16384,
        "model_limits": {
          "gpt-4o": {
            "context_window": 128000,
            "max_output_tokens": 16384
          }
        },
        "instruction_role": "system",
        "disable_streaming": false,
        "stream_include_usage": true,
        "omit_tool_choice": false,
        "max_attempts": 3,
        "timeout_seconds": 1800,
        "connect_timeout_seconds": 20,
        "response_header_timeout_seconds": 120
      }
    },
    "local": {
      "type": "openai-compatible",
      "openai_compatible": {
        "base_url": "http://127.0.0.1:11434/v1",
        "model": "your-local-model",
        "instruction_role": "system",
        "stream_include_usage": true,
        "max_attempts": 3
      }
    }
  },
  "ssh_profiles": {}
}
